SUBSYSTEM=="gpio", KERNEL=="gpiochip*", PROGRAM="/bin/sh -c '\
        chown root:devop /sys/class/gpio/export /sys/class/gpio/unexport && \
        chmod 220 /sys/class/gpio/export /sys/class/gpio/unexport'"

SUBSYSTEM=="gpio" KERNEL=="gpio*", PROGRAM="/bin/sh -c '\
        chown root:devop /sys%p/active_low /sys%p/direction /sys%p/edge /sys%p/value && \
        chmod 660 /sys%p/active_low /sys%p/direction /sys%p/edge /sys%p/value'"

SUBSYSTEM=="spidev", MODE="0660", GROUP="devop"
SUBSYSTEM=="tty", MODE="0660", GROUP="devop"